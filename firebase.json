{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/privacidad", "destination": "/privacidad.html" },
      { "source": "/terminos", "destination": "/terminos.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(html|png)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  }
}
