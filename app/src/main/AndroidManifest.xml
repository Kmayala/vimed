<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de red (chatbot con API Anthropic) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permisos de notificaciones y alarmas -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Para que Vita escuche. Se pide en el momento de tocar el micrófono,
         no al abrir la app: pedir permisos antes de que se entienda para
         qué sirven es la forma más rápida de que los nieguen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permite abrir el diálogo de "quitar optimización de batería" para
         ESTA app, en vez de mandar a la persona a una lista del sistema
         donde tiene que encontrarla.
         En muchos celulares —MIUI entre ellos— esa lista arranca filtrada y
         Vimed directamente no aparece, así que el ajuste era inalcanzable.
         Google Play restringe este permiso, pero lo admite justamente para
         apps de alarmas y recordatorios, que es lo que esta es. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Alarma a pantalla completa (como despertador) + vibración -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AlarmaService: reproduce el tono en loop con la app cerrada.
         WAKE_LOCK mantiene la CPU despierta mientras suena; sin eso el
         audio se corta cuando el celular vuelve a dormirse. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Desde Android 11 una app no ve qué otras apps hay instaladas salvo
         que lo declare. Sin esto, resolveActivity() para un enlace geo:
         devuelve null aunque el celular tenga Google Maps, y la fila del
         lugar de la cita contestaría siempre "no hay app de mapas". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".VimedApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vimed">


        <!-- Pantalla de bienvenida — LAUNCHER -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" />

        <!-- Deep link del correo de recuperación de contraseña.
             Se ABRE con vimed://reset-password#access_token=...&type=recovery -->
        <activity
            android:name=".ResetPasswordActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vimed" android:host="reset-password" />
            </intent-filter>
        </activity>
        <activity android:name=".RoleSelectionActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- Home del rol familiar/cuidador -->
        <activity android:name=".CuidadorActivity" android:exported="false" />

        <activity
            android:name=".AgregarMedicamentoActivity"
            android:exported="false" />

        <activity android:name=".MedsListActivity" android:exported="false" />
        <activity android:name=".ConfiguracionActivity" android:exported="false" />
        <activity android:name=".OlvidosActivity" android:exported="false" />
        <activity android:name=".MedicamentoDetalleActivity" android:exported="false" />
        <activity android:name=".EditarMedicamentoActivity" android:exported="false" />

        <!-- Clave del Maps SDK. Sale de MAPS_API_KEY en local.properties
             (o de la variable de entorno en CI); ver app/build.gradle. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Que Play Services baje el modelo del lector AL INSTALAR y no en
             el primer escaneo. Sin esto, la primera foto —que es la que se
             saca parada en la farmacia— tendría que esperar una descarga. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- Le presta a la cámara del sistema un lugar donde dejar la foto
             de la caja. exported=false y grantUriPermissions: el permiso se
             da por foto y se vence solo. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_camara" />
        </provider>
        <activity android:name=".AppointmentsActivity" android:exported="false" />
        <activity android:name=".DashboardActivity" android:exported="false" />
        <activity android:name=".AgregarCitaActivity" android:exported="false" />
        <activity android:name=".CitaDetalleActivity" android:exported="false" />
        <activity android:name=".VincularFamiliarActivity" android:exported="false" />

        <!-- Selector de ubicación: mapa de OpenStreetMap en un WebView.

             adjustNothing y NO adjustResize: con resize, al abrirse el
             teclado el mapa —que ocupa el alto sobrante— se comprimía hasta
             desaparecer, y parecía que la pantalla se cerraba sola. El
             buscador está arriba de todo, así que el teclado puede tapar lo
             de abajo sin estorbar lo que hay que ver mientras se escribe. -->
        <activity
            android:name=".SeleccionarUbicacionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:name=".ChatbotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Alarma a pantalla completa del recordatorio de medicación.
             showWhenLocked + turnScreenOn: se abre y prende la pantalla aunque
             el celular esté bloqueado. singleInstance + excludeFromRecents:
             no se apila ni queda en "recientes". -->
        <activity
            android:name=".AlarmaActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Vimed.Alarma" />

        <!-- Hace sonar la alarma de medicación. En primer plano porque tiene
             que seguir sonando con la app cerrada y la pantalla apagada. -->
        <service
            android:name=".utils.AlarmaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Recibe los push de Firebase (avisos al cuidador) -->
        <service
            android:name=".utils.VimedFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Receptor de alarmas: recordatorios de medicación y de citas -->
        <receiver
            android:name=".utils.AlarmaReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="com.tesis.vimed.FIRE" />
                <action android:name="com.tesis.vimed.CONFIRM" />
                <action android:name="com.tesis.vimed.SNOOZE" />
                <action android:name="com.tesis.vimed.CITA" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
