<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════
         PALETA VIMED — MODO OSCURO

         Negro real con acentos neón, no un violeta apagado.

         La versión anterior teñía TODO de violeta, incluidos los
         fondos, con la idea de que se leyera como la misma app con la
         luz baja. En la práctica quedaba lavada: sobre un fondo que ya
         tiene color, cualquier acento pierde fuerza, y todo terminaba
         pareciéndose entre sí. Con el fondo en negro los colores
         recuperan saturación y se pueden usar brillantes.

             fondo    #000000   negro
             tarjeta  #121212   apenas levantada
             bordes   #2F2F2F   lo que separa una capa de otra

         Mismos nombres que en values/colors.xml: ninguna pantalla sabe
         en qué modo está, solo pide @color/loquesea.

         La regla para traducir cada token sigue siendo respetar su ROL,
         no invertir el color. Un token que en claro es fondo suave acá
         es un fondo apenas más claro que la página; uno que en claro es
         texto tiene que volverse CLARO o desaparece.

         Contrastes sobre la tarjeta #121212:
           ink 18.7 · ink_3 9.4 · ink_4 7.4
           verde 10.5 · azul 9.3 · amarillo 12.2 · naranja 7.2
           violeta 7.3 · rosa 7.1 · blanco sobre brand_500 9.4
         ═══════════════════════════════════════════════════════ -->

    <!-- ── Primario ───────────────────────────────────────────
         500 queda IGUAL que en claro: es el relleno de los botones y
         de la burbuja del chat, y encima lleva texto blanco escrito a
         mano en los layouts. Si se aclarara, ese blanco perdería
         contraste. Los tonos de TEXTO (600 en adelante) sí pasan al
         violeta neón.                                            -->
    <color name="brand_50">#171018</color>    <!-- fondo suave / ripple -->
    <color name="brand_100">#241a2e</color>   <!-- círculos de ícono, chips -->
    <color name="brand_200">#cd88ff</color>   <!-- texto sobre superficie oscura -->
    <color name="brand_300">#daa6ff</color>
    <color name="brand_400">#8e5cb8</color>
    <color name="brand_500">#5e2585</color>   <!-- primario (sin cambios) -->
    <color name="brand_600">#cd88ff</color>   <!-- texto/íconos sobre fondo -->
    <color name="brand_700">#daa6ff</color>   <!-- texto sobre brand_100 -->
    <color name="brand_800">#e6c4ff</color>
    <color name="brand_900">#f0dcff</color>

    <!-- ══ FAMILIAS DE SECCIÓN, en neón ══════════════════════════
         El _50 es el fondo oscuro de la familia, el _500 el neón que
         se usa como relleno o gráfico, y el _700 el mismo neón un paso
         más claro para cuando va como texto.                      -->

    <color name="azul_50">#0a1a24</color>
    <color name="azul_100">#0f2937</color>
    <color name="azul_200">#5aa9ff</color>
    <color name="azul_500">#5aa9ff</color>
    <color name="azul_600">#7dbcff</color>
    <color name="azul_700">#a3cdff</color>

    <color name="verde_50">#0a1f14</color>
    <color name="verde_100">#0f3220</color>
    <color name="verde_500">#3ddc84</color>
    <color name="verde_700">#66e6a0</color>

    <color name="naranja_50">#241009</color>
    <color name="naranja_100">#361a0f</color>
    <color name="naranja_500">#ff7847</color>
    <color name="naranja_700">#ff9670</color>

    <color name="amarillo_50">#241d08</color>
    <color name="amarillo_100">#372c0c</color>
    <color name="amarillo_500">#ffc93c</color>
    <color name="amarillo_700">#ffd76b</color>


    <color name="rosa_50">#240a17</color>
    <color name="rosa_100">#371022</color>
    <color name="rosa_500">#ff6fb0</color>
    <color name="rosa_700">#ff8ec3</color>

    <!-- Alias legacy -->
    <color name="turquesa">#5e2585</color>
    <color name="turquesa_dark">#cd88ff</color>
    <color name="turquesa_light">#171018</color>
    <color name="turquesa_border">#241a2e</color>

    <!-- ── Neutrales: la escala de ink se da vuelta ───────────
         Grises neutros, sin tinte: es lo que deja que los neones se
         vean neón. Un gris violáceo se los come.                 -->
    <color name="ink">#ffffff</color>         <!-- texto principal -->
    <color name="ink_2">#e8e8e8</color>
    <color name="ink_3">#b8b8b8</color>
    <color name="ink_4">#a3a3a3</color>
    <color name="ink_5">#8a8a8a</color>
    <color name="ink_6">#6b6b6b</color>
    <!-- El borde es lo único que separa una tarjeta del fondo: dos
         superficies oscuras nunca se van a distinguir por su relleno. -->
    <color name="ink_7">#383838</color>       <!-- bordes / divisores -->
    <color name="ink_8">#1c1c1c</color>
    <color name="paper">#000000</color>       <!-- fondo de pantalla -->
    <color name="paper_2">#121212</color>     <!-- cards -->

    <!-- Alias legacy -->
    <color name="gris_fondo">#000000</color>
    <color name="gris_borde">#2f2f2f</color>
    <color name="gris_texto">#a3a3a3</color>

    <!-- ── Semánticos ─────────────────────────────────────────
         El color plano se usa como TEXTO y va en neón; el _bg es
         fondo y se hunde.                                        -->
    <color name="success">#3ddc84</color>
    <color name="success_bg">#0a1f14</color>
    <color name="warn">#ffc93c</color>
    <color name="warn_bg">#241d08</color>
    <color name="warn_border">#4a3a10</color>
    <color name="danger">#ff8a8a</color>
    <color name="danger_bg">#2a0f0f</color>
    <color name="info">#4cc2ff</color>
    <color name="info_bg">#0a1a24</color>

    <!-- Los pill_* NO se redefinen acá: llevan la inicial del
         medicamento en BLANCO encima, y ese blanco no cambia de modo.
         Aclararlos "para que no se pierdan en el fondo" rompía justamente
         el único par que importaba (daban 2.4 contra el blanco). -->

    <!-- ── Texto ──────────────────────────────────────────── -->
    <color name="texto_principal">#ffffff</color>

    <!-- ── Superficie destacada ───────────────────────────────
         En claro es la tarjeta violeta que resalta sobre la página.
         Acá la página es negra, así que resaltar es LEVANTARSE: un
         gris un paso por encima de la tarjeta común, y que el color lo
         pongan los acentos neón de adentro.                      -->
    <color name="surface_dark">#1e1e1e</color>
    <color name="surface_dark_2">#2a2a2a</color>
</resources>
