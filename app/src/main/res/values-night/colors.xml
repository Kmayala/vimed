    <color name="azul_100">#0f2937</color>
    <color name="azul_200">#6fb4ff</color>
    <color name="azul_500">#6fb4ff</color>
    <color name="azul_600">#8dc4ff</color>
    <color name="azul_700">#a3cdff</color>

