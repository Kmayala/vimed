<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de tomas sin confirmar en la semana.
     Es la única puerta a la pantalla de olvidos desde el home del adulto
     mayor: si no está, una toma que se perdió el martes no se ve más y
     arrastra el porcentaje de adherencia sin que nadie pueda corregirla.
     Aparece solo cuando hay algo que corregir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_olvidos"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_warn_alert"
    android:padding="16dp"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_banner_olvidos_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/warn" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Si las tomaste, marcalas acá"
            android:textSize="14sp"
            android:textColor="@color/warn"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/warn"
        android:contentDescription="Ver" />

</LinearLayout>
