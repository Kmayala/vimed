<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de alarma a pantalla completa (full-screen intent).
     Pensada para adulto mayor: textos grandes, botones enormes,
     alto contraste. Se abre incluso con el celular bloqueado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_600"
    android:gravity="center"
    android:padding="24dp">

    <!-- Círculo con la campana. Ambos llevan id: la campana se balancea y
         el círculo late mientras suena la alarma (ver AlarmaActivity). -->
    <FrameLayout
        android:id="@+id/alarma_circulo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_alarma_icono">

        <ImageView
            android:id="@+id/alarma_campana"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bell"
            app:tint="@color/white"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Hora actual grande -->
    <TextView
        android:id="@+id/alarma_hora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/white"
        android:textSize="64sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hora de tu medicamento"
        android:textColor="@color/brand_100"
        android:textSize="22sp" />

    <!-- Nombre y dosis del medicamento -->
    <TextView
        android:id="@+id/alarma_medicamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Medicamento"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.1" />

    <!-- Espaciador flexible -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón principal: Ya tomé mi medicación.
         MaterialButton explícito + app:backgroundTint. NO poner android:background:
         el tema infla los <Button> como MaterialButton, y al ver un background
         propio le reenvía igual el tint del tema (colorPrimary = brand_500) a
         AppCompat, que tiñe de violeta el shape blanco y lo deja "lavado".
         insetTop/Bottom en 0: el fondo se envuelve en un InsetDrawable de 4dp
         y perderíamos 8dp de alto pintado.
         Alto por minHeight y no fijo: con la fuente del sistema agrandada
         (habitual en adulto mayor) el texto pasa a más líneas y se recortaría. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ya_tome"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="✓  Ya tomé mi medicación"
        android:textColor="@color/brand_700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:backgroundTint="@color/white"
        app:cornerRadius="20dp"
        app:elevation="0dp"
        app:rippleColor="#66958CE8" />

    <!-- Botón secundario: Posponer.
         Relleno transparente a propósito: el velo blanco anterior subía el fondo
         y bajaba el contraste del texto blanco de 4.39:1 a 3.49:1. El contorno
         blanco sólido de 2dp alcanza para que se lea como botón. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_posponer"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Posponer 15 minutos"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="20dp"
        app:elevation="0dp"
        app:strokeColor="@color/white"
        app:strokeWidth="2dp"
        app:rippleColor="#59FFFFFF" />

</LinearLayout>
