<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progreso"
                android:textSize="32sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/ink_4"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tv_cartel_paciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_note"
                android:padding="14dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/brand_700"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- ─── Selector de período ───
                 Tres rangos: la semana dice cómo viene ahora, el trimestre
                 si el tratamiento se sostiene. Sin poder cambiarlo, la
                 pantalla contestaba una sola pregunta. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/chip_7"
                    style="@style/ChipPeriodo"
                    android:text="7 días" />

                <TextView
                    android:id="@+id/chip_30"
                    style="@style/ChipPeriodo"
                    android:layout_marginStart="8dp"
                    android:text="30 días" />

                <TextView
                    android:id="@+id/chip_90"
                    style="@style/ChipPeriodo"
                    android:layout_marginStart="8dp"
                    android:text="3 meses" />
            </LinearLayout>

            <!-- ─── Tarjeta principal ───
                 El porcentaje es el héroe: serif grande, alineado a la
                 izquierda como los títulos de la app. Antes iba chico
                 adentro de un anillo de 128dp que se comía media
                 pantalla para decir un solo número. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/shape_card"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingTop="26dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/tv_animo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_600"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_adherence_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="64sp"
                    android:fontFamily="@font/atkinson"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false"
                    android:text="—" />

                <TextView
                    android:id="@+id/tv_resumen_semana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textColor="@color/ink_3"
                    android:lineSpacingMultiplier="1.35"
                    android:layout_marginTop="10dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_semana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:indicatorColor="@color/brand_500"
                    app:trackColor="@color/ink_8"
                    app:trackThickness="10dp"
                    app:trackCornerRadius="5dp"
                    android:progress="0"
                    android:max="100"
                    android:layout_marginTop="22dp" />

                <LinearLayout
                    android:id="@+id/card_racha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sparkle"
                        android:tint="@color/brand_600"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Racha" />

                    <TextView
                        android:id="@+id/tv_racha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textColor="@color/ink_2"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Gráfico por día ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Día por día"
                android:textSize="21sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tocá una barra para ver ese día."
                android:textSize="15sp"
                android:textColor="@color/ink_4"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_card"
                android:padding="18dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/grafico_dias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom" />
            </HorizontalScrollView>

            <!-- ─── Por medicamento ─── -->
            <TextView
                android:id="@+id/tv_titulo_meds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Por medicamento"
                android:textSize="21sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/meds_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ─── Horarios que más se pierden ─── -->
            <TextView
                android:id="@+id/tv_titulo_flojos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Los horarios que más se pierden"
                android:textSize="21sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/flojos_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_sin_datos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_dose_card"
                android:padding="26dp"
                android:gravity="center"
                android:text="Todavía no hay tomas registradas en este período."
                android:textSize="16sp"
                android:textColor="@color/ink_4"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_2"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_icono_color"
        app:itemActiveIndicatorStyle="@style/IndicadorNav"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
