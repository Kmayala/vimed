<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progreso"
                android:textSize="30sp"
                android:fontFamily="serif"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/ink_4"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <!-- KPI Card: Adherencia mensual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/shape_brand_gradient"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADHERENCIA MENSUAL"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#CCFFFFFF"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_adherence_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–%"
                    android:textSize="64sp"
                    android:fontFamily="serif"
                    android:textStyle="normal"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="-0.03"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregue medicamentos para ver su progreso"
                    android:textSize="14sp"
                    android:textColor="#E0FFFFFF"
                    android:layout_marginTop="-4dp" />

            </LinearLayout>

            <!-- Información: por medicamento -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Por medicamento"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:letterSpacing="-0.015"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/meds_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Estado vacío -->
                <LinearLayout
                    android:id="@+id/empty_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:background="@drawable/shape_dose_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin datos disponibles"
                        android:textSize="16sp"
                        android:textColor="@color/ink_4"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Los datos de adherencia aparecerán aquí cuando confirme tomas"
                        android:textSize="14sp"
                        android:textColor="@color/ink_5"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_2"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
