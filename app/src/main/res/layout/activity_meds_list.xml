<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicamentos"
                android:textSize="32sp"
                android:fontFamily="@font/atkinson"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_meds_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/ink_4"
                android:layout_marginTop="4dp"
                android:text="Activos" />

        </LinearLayout>

        <!-- Botón agregar -->
        <FrameLayout
            android:id="@+id/btn_add_med"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/shape_logo_container"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_add"
                android:tint="#FFFFFF"
                android:contentDescription="Agregar medicamento" />
        </FrameLayout>

    </LinearLayout>

    <!-- Contenido scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="28dp">

            <!-- Cartel de contexto del cuidador. Ver ModoPaciente: sin
                 esto es fácil creer que la lista es la propia y cargarle
                 un medicamento a la persona equivocada. -->
            <TextView
                android:id="@+id/tv_cartel_paciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_note"
                android:padding="14dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/brand_700"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- Estado vacío — FUERA del meds_container para que no sea eliminado -->
            <LinearLayout
                android:id="@+id/empty_meds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="44dp"
                android:paddingBottom="44dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:background="@drawable/shape_dose_card"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:elevation="3dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_nav_meds"
                    android:tint="@color/ink_5"
                    android:contentDescription="Sin medicamentos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tv_meds_vacio"
                    android:text="Aún no tenés medicamentos"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_2"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/tv_meds_vacio_detalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregá el primero y te vamos a recordar cada toma a su hora."
                    android:textSize="16sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_first"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="Agregar medicamento"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    app:backgroundTint="@color/brand_500"
                    app:cornerRadius="18dp"
                    android:layout_marginTop="22dp" />

            </LinearLayout>

            <!-- Contenedor de tarjetas de medicamentos -->
            <LinearLayout
                android:id="@+id/meds_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_nav_flotante"
        android:elevation="8dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_icono_color"
        app:itemActiveIndicatorStyle="@style/IndicadorNav"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
