<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/ink_2"
                android:contentDescription="Volver" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_toolbar_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vincular familiar"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:letterSpacing="-0.015" />

    </LinearLayout>

    <!-- Contenido -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- Título e intro -->
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/tv_titulo"
                android:layout_height="wrap_content"
                android:text="Invite a un cuidador"
                android:textSize="30sp"
                android:fontFamily="@font/atkinson"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:id="@+id/tv_subtitulo"
                android:layout_height="wrap_content"
                android:text="Recibirá avisos de olvidos, stock bajo y citas próximas. Usted decide qué comparte."
                android:textSize="15sp"
                android:textColor="@color/ink_3"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginBottom="28dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="nombre@correo.com"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:inputType="textEmailAddress"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Boton.Principal"
                android:id="@+id/btn_add_by_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Agregar familiar"
                android:textSize="15sp"
                android:backgroundTint="@color/brand_500"
                app:cornerRadius="16dp"
                android:layout_marginBottom="32dp" />

            <!-- Sección FAMILIA VINCULADA -->
            <TextView
                android:layout_width="match_parent"
                android:id="@+id/tv_seccion_lista"
                android:layout_height="wrap_content"
                android:text="FAMILIA VINCULADA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/ink_4"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <!-- Estado vacío -->
            <LinearLayout
                android:id="@+id/empty_family"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp"
                android:background="@drawable/shape_dose_card"
                android:visibility="gone"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/tv_vacio_titulo"
                    android:layout_height="wrap_content"
                    android:text="Sin familiares vinculados"
                    android:textSize="15sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/tv_vacio_detalle"
                    android:layout_height="wrap_content"
                    android:text="Comparta el código o agregue por correo"
                    android:textSize="13sp"
                    android:textColor="@color/ink_5"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Lista de familiares vinculados -->
            <LinearLayout
                android:id="@+id/family_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
