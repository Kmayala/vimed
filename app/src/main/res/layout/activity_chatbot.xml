<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- AppBar Vita -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Botón volver -->
        <FrameLayout
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Volver" />
        </FrameLayout>

        <!-- Avatar + nombre + subtítulo (agrupados como header de chat) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar Vita -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/shape_vita_avatar"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sparkle"
                    android:contentDescription="Vita" />
            </FrameLayout>

            <!-- Nombre + subtítulo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vita"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <!-- Punto verde online -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_online_dot"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asistente de medicación"
                    android:textSize="12sp"
                    android:textColor="@color/ink_4" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botón limpiar historial -->
        <FrameLayout
            android:id="@+id/btn_clear_chat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Limpiar historial" />
        </FrameLayout>

    </LinearLayout>

    <!-- Área del chat -->
    <ScrollView
        android:id="@+id/scroll_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/chat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Sugerencias — visibles cuando el historial está vacío -->
            <LinearLayout
                android:id="@+id/suggested_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <!-- Avatar grande centrado -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_vita_avatar"
                    android:layout_gravity="center">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sparkle"
                        android:contentDescription="Vita" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hola, soy Vita"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Su asistente de medicación. ¿En qué le puedo ayudar?"
                    android:textSize="14sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp" />

                <!-- Fila 1 de chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/chip_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¿Puedo tomar pastillas con café?"
                        android:textSize="13sp"
                        android:textColor="@color/brand_700"
                        android:background="@drawable/shape_prompt_chip"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olvidé una toma"
                        android:textSize="13sp"
                        android:textColor="@color/brand_700"
                        android:background="@drawable/shape_prompt_chip"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Fila 2 de chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Efectos secundarios"
                        android:textSize="13sp"
                        android:textColor="@color/brand_700"
                        android:background="@drawable/shape_prompt_chip"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Horario de medicamentos"
                        android:textSize="13sp"
                        android:textColor="@color/brand_700"
                        android:background="@drawable/shape_prompt_chip"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra compositora -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/paper_2"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <!-- Input pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/shape_chat_composer"
            android:paddingLeft="16dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Escribe un mensaje..."
                android:textColorHint="@color/ink_5"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:background="@null"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <!-- Botón micrófono -->
            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_neutral_icon_container"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Voz" />
            </FrameLayout>

        </LinearLayout>

        <!-- Botón enviar -->
        <FrameLayout
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_send_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                android:contentDescription="Enviar" />
        </FrameLayout>

    </LinearLayout>

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_nav_flotante"
        android:elevation="8dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
