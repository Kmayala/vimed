<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_dose_card"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <FrameLayout
        android:id="@+id/act_icon_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/shape_brand_icon_container"
        android:layout_marginEnd="14dp">

        <ImageView
            android:id="@+id/act_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:tint="@color/brand_600"
            android:contentDescription="Actividad" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/act_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/ink_2"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/act_fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/ink_4"
            android:layout_marginTop="3dp" />
    </LinearLayout>

</LinearLayout>
