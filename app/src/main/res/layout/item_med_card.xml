<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_card"
    android:padding="18dp"
    android:layout_marginTop="14dp"
    android:clickable="true"
    android:focusable="true"
    android:elevation="3dp">

    <!-- Ícono circular con inicial -->
    <FrameLayout
        android:id="@+id/med_icon_container"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/tv_med_initial"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <!-- Info del medicamento -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Nombre + dosis en la misma línea -->
        <TextView
            android:id="@+id/tv_med_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/tv_med_dosis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/ink_3"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tv_med_inst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/ink_4"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_med_horario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/brand_600"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <!-- Chip de stock -->
        <TextView
            android:id="@+id/tv_med_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_chip_ink"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ink_3"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/ink_5"
        android:contentDescription="Opciones"
        android:layout_marginStart="8dp" />

</LinearLayout>
