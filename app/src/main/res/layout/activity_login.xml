<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <!-- AppBar con botón volver -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Volver"
            android:scaleType="center"
            android:tint="@color/ink_2" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- Marca -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/shape_logo_container"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_vimed_logo"
                        android:contentDescription="Logo Vimed" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="38sp"
                android:fontFamily="serif"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.05"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingrese con su correo y contraseña"
                android:textSize="18sp"
                android:textColor="@color/ink_3"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginBottom="36dp" />

            <!-- Campo de correo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/brand_500"
                app:hintTextColor="@color/ink_3"
                android:textColorHint="@color/ink_4"
                android:layout_marginBottom="18dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:inputType="textEmailAddress"
                    android:textSize="19sp"
                    android:textColor="@color/ink"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo de contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/ink_3"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxStrokeColor="@color/brand_500"
                app:hintTextColor="@color/ink_3"
                android:textColorHint="@color/ink_4"
                android:layout_marginBottom="6dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:inputType="textPassword"
                    android:textSize="19sp"
                    android:textColor="@color/ink"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Link olvidé contraseña — alineado a la derecha, bajo el campo -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_forgot_password"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textSize="16sp"
                android:textColor="@color/brand_600"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/brand_50"
                android:layout_marginBottom="24dp" />

            <!-- Botón ingresar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/btn_login"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                app:backgroundTint="@color/brand_500"
                app:cornerRadius="18dp"
                app:elevation="2dp"
                android:layout_marginBottom="20dp" />

            <!-- Separador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/ink_7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="o"
                    android:textSize="15sp"
                    android:textColor="@color/ink_4"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/ink_7" />
            </LinearLayout>

            <!-- Entrar con Google. Va DEBAJO del login por correo y no
                 arriba: quien ya tiene cuenta creada en la app entra por
                 donde siempre, y Google queda como alternativa. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_google"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Continuar con Google"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/ink_2"
                app:icon="@drawable/ic_esp_cruz"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/brand_600"
                app:strokeColor="@color/ink_7"
                app:strokeWidth="1.5dp"
                app:cornerRadius="18dp" />

            <!-- Separador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/ink_7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="o"
                    android:textSize="15sp"
                    android:textColor="@color/ink_4"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/ink_7" />
            </LinearLayout>

            <!-- Link registro -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_register"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/tv_no_account_login"
                android:textSize="18sp"
                android:textColor="@color/ink_2"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/ink_6"
                app:strokeWidth="1.5dp"
                app:cornerRadius="18dp"
                app:rippleColor="@color/brand_50" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
