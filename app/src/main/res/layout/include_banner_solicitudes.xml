<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de solicitudes de vínculo esperando respuesta.
     Va en el home de los dos roles: la pantalla de vinculación está
     detrás del menú de perfil, y nadie entra ahí a mirar si le llegó
     algo. Sin este banner, una solicitud podía quedar sin responder
     para siempre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_solicitudes"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_card_violeta"
    android:padding="18dp"
    android:layout_marginBottom="16dp"
    android:elevation="3dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Círculo con la campana. Antes el aviso era dos renglones de texto
         sobre un fondo apenas tintado y se leía como un subtítulo más de la
         pantalla: la persona pasaba de largo y la solicitud quedaba sin
         responder. Con el ícono en su círculo lleno pesa como una tarjeta. -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/shape_brand_icon_container"
        android:layout_marginEnd="14dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_users"
            android:tint="@color/brand_600"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_banner_solicitudes_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/brand_700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tocá para aceptarla o rechazarla"
            android:textSize="15sp"
            android:textColor="@color/brand_700"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/brand_700"
        android:contentDescription="Revisar" />

</LinearLayout>
