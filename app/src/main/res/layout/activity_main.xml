<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <!-- ═══════════════════════════════════════
         AppBar grande: saludo + íconos
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Saludo + fecha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buen día,"
                android:textSize="32sp"
                android:fontFamily="serif"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:fontFamily="serif"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/ink_4"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Botón alertas -->
        <FrameLayout
            android:id="@+id/btn_alerts"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                android:contentDescription="Alertas" />
        </FrameLayout>

        <!-- Botón perfil -->
        <FrameLayout
            android:id="@+id/btn_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user"
                android:contentDescription="Perfil" />
        </FrameLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════
         Contenido scrollable
         ═══════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp">

            <!-- ─── Alerta de interacción (warn) ─── -->
            <LinearLayout
                android:id="@+id/alert_interaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_warn_alert"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/shape_warn_icon_circle"
                    android:layout_marginEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_warn"
                        android:contentDescription="Advertencia" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_interaction_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="@color/warn"
                    android:lineSpacingMultiplier="1.35" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/warn"
                    android:contentDescription="Ver detalle" />

            </LinearLayout>

            <!-- ─── Sugerencia de ajuste de recordatorio ───
                 La app propone, la persona decide. Nunca se aplica sola:
                 la hora de una medicación la indicó un médico. -->
            <LinearLayout
                android:id="@+id/card_sugerencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/shape_card"
                android:padding="18dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/shape_brand_icon_container"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_sparkle"
                            android:tint="@color/brand_700"
                            android:contentDescription="Sugerencia" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_sugerencia_titulo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sugerencia_detalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/ink_3"
                    android:lineSpacingMultiplier="1.35"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_sugerencia_no"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Ahora no"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_sugerencia_si"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ─── Alerta de stock bajo ─── -->
            <LinearLayout
                android:id="@+id/alert_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_warn_alert"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/shape_warn_icon_circle"
                    android:layout_marginEnd="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_meds"
                        android:tint="#FFFFFF"
                        android:contentDescription="Stock bajo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_stock_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textColor="@color/warn"
                    android:lineSpacingMultiplier="1.35" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/warn"
                    android:contentDescription="Ver medicamentos" />

            </LinearLayout>

            <!-- ─── Tarjeta de progreso ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_card"
                android:padding="22dp"
                android:layout_marginBottom="28dp">

                <!-- Anillo de progreso -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="20dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_ring"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        app:indicatorColor="@color/brand_500"
                        app:trackColor="@color/ink_7"
                        app:trackThickness="8dp"
                        app:indicatorSize="76dp"
                        android:progress="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_progress_pct"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:letterSpacing="-0.02"
                        android:text="0%" />

                </FrameLayout>

                <!-- Texto de progreso -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOY"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_4"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_doses_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:letterSpacing="-0.01"
                        android:layout_marginTop="5dp"
                        android:text="0 de 0 tomas" />

                    <TextView
                        android:id="@+id/tv_next_dose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/ink_4"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ─── Encabezado "Hoy" + chip ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hoy"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tv_total_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_chip_ink"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_3"
                    android:text="0 tomas" />

            </LinearLayout>

            <!-- Ayuda: cómo confirmar -->
            <TextView
                android:id="@+id/tv_hint_tap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tocá una toma para marcarla como tomada."
                android:textSize="15sp"
                android:textColor="@color/ink_4"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- ─── Lista de tomas (inflada desde Java) ─── -->
            <LinearLayout
                android:id="@+id/doses_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Estado vacío (sin medicamentos) -->
            <LinearLayout
                android:id="@+id/empty_doses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="36dp"
                android:paddingBottom="36dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:background="@drawable/shape_dose_card"
                android:visibility="visible">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_nav_meds"
                    android:tint="@color/ink_5"
                    android:contentDescription="Sin medicamentos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin medicamentos registrados"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_2"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregá el primero para empezar a recibir recordatorios."
                    android:textSize="16sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_first_med"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:text="Agregar medicamento"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    app:backgroundTint="@color/brand_500"
                    app:cornerRadius="18dp"
                    android:layout_marginTop="20dp" />

            </LinearLayout>

            <!-- ─── Accesos rápidos ─── -->
            <LinearLayout
                android:id="@+id/quick_meds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_card"
                android:padding="18dp"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/shape_icon_purple"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_meds"
                        android:tint="#FFFFFF"
                        android:contentDescription="Medicamentos" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medicamentos"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_quick_meds_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_600"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_5"
                    android:contentDescription="Ver medicamentos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_card"
                android:padding="18dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/shape_icon_blue"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        android:tint="#FFFFFF"
                        android:contentDescription="Recordatorios" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recordatorios"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_quick_reminders_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_600"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_5"
                    android:contentDescription="Ver recordatorios" />
            </LinearLayout>

            <!-- ─── Próxima cita ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Próxima cita"
                android:textSize="26sp"
                android:fontFamily="serif"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />

            <!-- Tarjeta de cita -->
            <LinearLayout
                android:id="@+id/appointment_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_card"
                android:padding="18dp"
                android:visibility="gone">

                <!-- Badge de fecha: mes + día -->
                <LinearLayout
                    android:id="@+id/appt_date_badge"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/shape_date_badge"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:id="@+id/tv_appt_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_700"
                        android:letterSpacing="0.12"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tv_appt_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_700"
                        android:lineSpacingMultiplier="0.9"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Info de la cita -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_appt_doctor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_appt_specialty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/ink_4"
                        android:layout_marginTop="3dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_map_pin"
                            android:tint="@color/ink_4"
                            android:contentDescription="Lugar" />

                        <TextView
                            android:id="@+id/tv_appt_place"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/ink_4"
                            android:layout_marginStart="5dp" />

                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_5"
                    android:contentDescription="Ver detalle" />

            </LinearLayout>

            <!-- Estado vacío citas -->
            <LinearLayout
                android:id="@+id/empty_appointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp"
                android:background="@drawable/shape_dose_card"
                android:visibility="visible">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_nav_calendar"
                    android:tint="@color/ink_5"
                    android:contentDescription="Sin citas"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin citas próximas"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_3"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuando agregues una cita médica la vas a ver acá."
                    android:textSize="15sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════
         Barra de navegación inferior
         ═══════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_2"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
