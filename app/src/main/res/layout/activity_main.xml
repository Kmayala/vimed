<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- ═══════════════════════════════════════
         AppBar grande: saludo + íconos
         ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- Saludo + fecha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buen día,"
                android:textSize="30sp"
                android:fontFamily="serif"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:fontFamily="serif"
                android:textStyle="normal"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/ink_4"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Botón alertas -->
        <FrameLayout
            android:id="@+id/btn_alerts"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                android:contentDescription="Alertas" />
        </FrameLayout>

        <!-- Botón perfil -->
        <FrameLayout
            android:id="@+id/btn_profile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user"
                android:contentDescription="Perfil" />
        </FrameLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════
         Contenido scrollable
         ═══════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <!-- ─── Alerta de interacción (warn) ─── -->
            <LinearLayout
                android:id="@+id/alert_interaction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_warn_alert"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/shape_warn_icon_circle"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_warn"
                        android:contentDescription="Advertencia" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_interaction_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="#6b3d00"
                    android:lineSpacingMultiplier="1.3" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="#6b3d00"
                    android:contentDescription="Ver detalle" />

            </LinearLayout>

            <!-- ─── Tarjeta de progreso ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_card"
                android:padding="18dp"
                android:layout_marginBottom="24dp">

                <!-- Anillo de progreso -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="18dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress_ring"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        app:indicatorColor="@color/brand_500"
                        app:trackColor="@color/ink_7"
                        app:trackThickness="6dp"
                        app:indicatorSize="60dp"
                        android:progress="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_progress_pct"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:letterSpacing="-0.02"
                        android:text="0%" />

                </FrameLayout>

                <!-- Texto de progreso -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOY"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_4"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tv_doses_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:letterSpacing="-0.01"
                        android:layout_marginTop="4dp"
                        android:text="0 de 0 tomas" />

                    <TextView
                        android:id="@+id/tv_next_dose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/ink_4"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ─── Encabezado "Hoy" + chip ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hoy"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.015" />

                <TextView
                    android:id="@+id/tv_total_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_chip_ink"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_3"
                    android:text="0 tomas" />

            </LinearLayout>

            <!-- ─── Lista de tomas (inflada desde Java) ─── -->
            <LinearLayout
                android:id="@+id/doses_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Estado vacío (sin medicamentos) -->
            <LinearLayout
                android:id="@+id/empty_doses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/shape_dose_card"
                android:visibility="visible">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_nav_meds"
                    android:tint="@color/ink_5"
                    android:contentDescription="Sin medicamentos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin medicamentos registrados"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_3"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toque + para agregar su primer medicamento"
                    android:textSize="14sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- ─── Próxima cita ─── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Próxima cita"
                android:textSize="22sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:letterSpacing="-0.015"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp" />

            <!-- Tarjeta de cita -->
            <LinearLayout
                android:id="@+id/appointment_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_card"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Badge de fecha: mes + día -->
                <LinearLayout
                    android:id="@+id/appt_date_badge"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/shape_date_badge"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:id="@+id/tv_appt_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_700"
                        android:letterSpacing="0.12"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tv_appt_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_700"
                        android:lineSpacingMultiplier="0.9"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Info de la cita -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_appt_doctor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_appt_specialty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/ink_4"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_map_pin"
                            android:tint="@color/ink_4"
                            android:contentDescription="Lugar" />

                        <TextView
                            android:id="@+id/tv_appt_place"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/ink_4"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_5"
                    android:contentDescription="Ver detalle" />

            </LinearLayout>

            <!-- Estado vacío citas -->
            <LinearLayout
                android:id="@+id/empty_appointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/shape_dose_card"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin citas próximas"
                    android:textSize="15sp"
                    android:textColor="@color/ink_4"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════
         Barra de navegación inferior
         ═══════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_2"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
