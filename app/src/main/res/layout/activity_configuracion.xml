<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/shape_neutral_icon_container"
            android:scaleType="center"
            android:tint="@color/ink_2"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Configuración"
            android:textSize="26sp"
            android:fontFamily="@font/atkinson"
            android:textColor="@color/ink"
            android:letterSpacing="-0.02"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp">

            <!-- ─── Datos del paciente ───
                 Van primero porque son los únicos ajustes que cambian lo
                 que la app le dice a la persona sobre su medicación; el
                 tema es preferencia, esto es información clínica.

                 La sección entera se puede ocultar: para un cuidador SIN
                 paciente vinculado no hay datos clínicos que editar. Los
                 suyos propios no los usa nadie —el chequeo de dosis mira
                 los de quien la toma—, así que pedírselos sería juntar un
                 dato de salud sin ninguna razón. -->
            <LinearLayout
                android:id="@+id/seccion_clinicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/tv_clinicos_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Datos del paciente"
                android:textSize="26sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_clinicos_subtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Con el peso y la edad, la app puede avisarte si una dosis que cargaste se aleja de la habitual para alguien como vos."
                android:textSize="16sp"
                android:textColor="@color/ink_3"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:id="@+id/opt_peso"
                style="@style/OpcionTema">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Peso"
                        android:textSize="18sp"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_peso_valor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/ink_3"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opt_edad"
                style="@style/OpcionTema">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edad"
                        android:textSize="18sp"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tv_edad_valor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/ink_3"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_note"
                android:padding="14dp"
                android:id="@+id/tv_clinicos_nota"
                android:text="Vimed nunca indica ni cambia una dosis. Solo compara lo que cargaste contra la referencia del medicamento y te dice si conviene revisarlo con tu médico."
                android:textSize="15sp"
                android:textColor="@color/brand_700"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="8dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apariencia"
                android:textSize="26sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El modo oscuro usa los mismos colores con menos brillo. Ayuda de noche y con poca luz."
                android:textSize="16sp"
                android:textColor="@color/ink_3"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginBottom="18dp" />

            <!-- Las tres opciones. Filas grandes y con su explicación:
                 "Según el sistema" no significa nada por sí solo para
                 alguien que nunca configuró un teléfono. -->
            <LinearLayout
                android:id="@+id/opt_sistema"
                style="@style/OpcionTema">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Según el sistema"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cambia solo cuando lo hace tu celular"
                        android:textSize="15sp"
                        android:textColor="@color/ink_3"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/check_sistema"
                    style="@style/CheckTema" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opt_claro"
                style="@style/OpcionTema">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Claro"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fondo blanco, siempre"
                        android:textSize="15sp"
                        android:textColor="@color/ink_3"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/check_claro"
                    style="@style/CheckTema" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/opt_oscuro"
                style="@style/OpcionTema">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oscuro"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fondo oscuro, siempre"
                        android:textSize="15sp"
                        android:textColor="@color/ink_3"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/check_oscuro"
                    style="@style/CheckTema" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_note"
                android:padding="14dp"
                android:text="La alarma de medicación suena igual en los dos modos."
                android:textSize="15sp"
                android:textColor="@color/brand_700"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="20dp" />

            <!-- ─── Revisión de la alarma ───
                 Estos permisos se piden una vez al abrir la app y, si la
                 persona dice "ahora no", no hay forma de volver a
                 encontrarlos. Acá quedan siempre a mano, con el estado de
                 cada uno a la vista. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Que la alarma suene siempre"
                android:textSize="26sp"
                android:fontFamily="@font/atkinson"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_alarma_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/ink_3"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/permisos_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Versión de la build. Sirve para saber si el celular tiene
                 la última: en Firebase todas las versiones se ven iguales
                 en la lista, así que sin esto hay que adivinar. -->
            <TextView
                android:id="@+id/tv_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/ink_5"
                android:layout_marginTop="26dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
