<?xml version="1.0" encoding="utf-8"?>
<!--
  Botón de una especialidad. El círculo del ícono lleva el color de la
  especialidad; al elegirla, el código pinta la tarjeta entera de ese
  color para que la selección se vea sin tener que leer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/shape_card"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/iv_icono"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="6dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/ink_2"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.15" />

</LinearLayout>
