<?xml version="1.0" encoding="utf-8"?>
<!--
  Fila de la lista de sugerencias del nombre del medicamento.

  El layout de Android (simple_dropdown_item_1line) trae la tipografía y
  los tamaños del sistema: texto chico, filas apretadas y colores que no
  son los de la app. Para un adulto mayor eligiendo su medicación, esas
  filas de 40dp con texto de 14sp son difíciles de acertar.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:gravity="center_vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:textSize="18sp"
    android:textColor="@color/ink"
    android:background="?android:attr/selectableItemBackground" />
