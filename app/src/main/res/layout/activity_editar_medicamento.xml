<?xml version="1.0" encoding="utf-8"?>
<!-- Edición en UNA pantalla, no en el asistente de 7 pasos.
     El asistente sirve para cargar algo desde cero, cuando conviene ir de a
     una pregunta. Para corregir un número, obligar a pasar por siete pasos
     es un castigo: la persona viene a cambiar una cosa y sabe cuál. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/shape_neutral_icon_container"
            android:scaleType="center"
            android:tint="@color/ink_2"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editar"
            android:textSize="24sp"
            android:fontFamily="@font/atkinson"
            android:textColor="@color/ink"
            android:letterSpacing="-0.02"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="32dp">

            <!-- ══ Qué es ══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qué es"
                android:textSize="15sp"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_3"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CampoForm"
                android:hint="Nombre"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:inputType="textCapSentences"
                    android:textSize="19sp"
                    android:textColor="@color/ink"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CampoForm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Dosis"
                    android:layout_marginEnd="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_dosis"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:inputType="numberDecimal"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_unidad"
                    style="@style/CampoForm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Unidad">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_unidad"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_presentacion"
                style="@style/CampoForm"
                android:hint="Presentación"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_presentacion"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:textSize="19sp"
                    android:textColor="@color/ink"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_instrucciones"
                style="@style/CampoForm"
                android:hint="Cómo tomarlo"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_instrucciones"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:textSize="19sp"
                    android:textColor="@color/ink"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ══ Cuándo ══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cuándo"
                android:textSize="15sp"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_3"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_hora"
                    style="@style/CampoForm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Primera toma"
                    android:layout_marginEnd="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_hora"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_frecuencia"
                    style="@style/CampoForm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Cada cuánto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_frecuencia"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_horas_resultantes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_note"
                android:padding="14dp"
                android:textSize="15sp"
                android:textColor="@color/brand_700"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp" />

            <!-- ══ El envase ══ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El envase"
                android:textSize="15sp"
                android:letterSpacing="0.08"
                android:textColor="@color/ink_3"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CampoForm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Cuántas quedan"
                    android:layout_marginEnd="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_stock"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:inputType="number"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CampoForm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Avisar en">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_stock_minimo"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:inputType="number"
                        android:textSize="19sp"
                        android:textColor="@color/ink"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_vencimiento"
                style="@style/CampoForm"
                android:hint="Vence el"
                app:helperText="Te avisamos 2 días antes. Está en la caja."
                app:helperTextTextColor="@color/ink_4"
                android:layout_marginBottom="28dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_vencimiento"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:inputType="none"
                    android:textSize="19sp"
                    android:textColor="@color/ink"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_guardar"
                style="@style/Boton.Principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="58dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Guardar cambios"
                android:textSize="17sp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
