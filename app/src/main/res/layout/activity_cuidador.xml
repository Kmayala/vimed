<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_welcome_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="14dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:fontFamily="serif"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de cuidador"
                android:textSize="16sp"
                android:textColor="@color/brand_600"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_profile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/shape_neutral_icon_container"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user"
                android:contentDescription="Perfil" />
        </FrameLayout>
    </LinearLayout>

    <!-- Alto 0 + peso 1: el scroll toma lo que sobra y la barra de abajo
         queda siempre visible. Con match_parent empujaba la barra fuera
         de la pantalla. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp">

            <!-- ═══ Sin paciente vinculado ═══ -->
            <LinearLayout
                android:id="@+id/empty_paciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/shape_card"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/shape_day_selected"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_users"
                        android:tint="@color/brand_500"
                        android:contentDescription="Sin paciente" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todavía no cuidás a nadie"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pedile a tu familiar que te vincule desde su app: en su perfil, opción «Vincular familiar», con tu correo."
                    android:textSize="16sp"
                    android:textColor="@color/ink_3"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- ═══ Contenido con paciente ═══ -->
            <LinearLayout
                android:id="@+id/content_paciente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Tarjeta del paciente (oscura, destacada).
                     Con más de un familiar a cargo se vuelve tocable para
                     cambiar de paciente. -->
                <LinearLayout
                    android:id="@+id/card_paciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/shape_card_dark"
                    android:padding="20dp"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ESTÁS CUIDANDO A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/sobre_superficie_oscura"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/tv_cambiar_paciente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cambiar"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/sobre_superficie_oscura"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_paciente_initial"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/shape_vita_avatar"
                            android:gravity="center"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_paciente_nombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="21sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:id="@+id/tv_paciente_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="15sp"
                                android:textColor="@color/sobre_superficie_oscura"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Resumen del día -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/shape_pill_dark"
                        android:padding="14dp"
                        android:layout_marginTop="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bell"
                            android:tint="#FFFFFF"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Hoy" />

                        <TextView
                            android:id="@+id/tv_resumen_hoy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Alerta stock -->
                <LinearLayout
                    android:id="@+id/alert_stock_cuidador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/shape_warn_alert"
                    android:padding="16dp"
                    android:layout_marginTop="14dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/shape_warn_icon_circle"
                        android:layout_marginEnd="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warn"
                            android:contentDescription="Alerta" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_stock_cuidador"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textColor="@color/warn"
                        android:lineSpacingMultiplier="1.35" />
                </LinearLayout>

                <!-- Acciones: cargar cosas PARA el adulto mayor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_agregar_med_cuidador"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="+ Medicamento"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/brand_500" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_agregar_cita_cuidador"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="+ Cita"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_700"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/brand_200" />
                </LinearLayout>

                <!-- ─── Cómo viene el tratamiento ───
                     Hechos, no sugerencias: el familiar decide con el
                     médico, la app no le propone cambios sobre el
                     tratamiento de otra persona. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cómo viene el tratamiento"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/card_adherencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/shape_dose_card"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_adherencia_titular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink"
                        android:lineSpacingMultiplier="1.25" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_adherencia_semana"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:textColor="@color/brand_700" />

                            <TextView
                                android:id="@+id/tv_adherencia_semana_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/ink_4" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_adherencia_mes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:textColor="@color/ink_3" />

                            <TextView
                                android:id="@+id/tv_adherencia_mes_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/ink_4" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_puntos_flojos_titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Los horarios que más se le pasan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink_2"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/puntos_flojos_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Tomas de hoy del paciente -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tomas de hoy"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/tomas_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_tomas_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_dose_card"
                    android:padding="24dp"
                    android:gravity="center"
                    android:text="Sin tomas registradas hoy"
                    android:textSize="16sp"
                    android:textColor="@color/ink_4"
                    android:visibility="gone" />

                <!-- Medicamentos cargados del adulto mayor -->
                <TextView
                    android:id="@+id/tv_titulo_meds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sus medicamentos"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tocá uno para cambiar el stock o darlo de baja"
                    android:textSize="14sp"
                    android:textColor="@color/ink_4"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/meds_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_meds_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_dose_card"
                    android:padding="24dp"
                    android:gravity="center"
                    android:text="Todavía no tiene medicamentos cargados"
                    android:textSize="16sp"
                    android:textColor="@color/ink_4"
                    android:visibility="gone" />

                <!-- Próximas citas médicas -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Próximas citas"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/citas_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_citas_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_dose_card"
                    android:padding="24dp"
                    android:gravity="center"
                    android:text="Sin citas agendadas"
                    android:textSize="16sp"
                    android:textColor="@color/ink_4"
                    android:visibility="gone" />

                <!-- Actividad reciente -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Actividad reciente"
                    android:textSize="26sp"
                    android:fontFamily="serif"
                    android:textColor="@color/ink"
                    android:letterSpacing="-0.02"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/actividad_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_actividad_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_dose_card"
                    android:padding="24dp"
                    android:gravity="center"
                    android:text="Sin actividad todavía"
                    android:textSize="16sp"
                    android:textColor="@color/ink_4"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_cuidador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/paper_2"
        app:menu="@menu/bottom_nav_cuidador"
        app:itemIconTint="@color/nav_icono_color"
        app:itemActiveIndicatorStyle="@style/IndicadorNav"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
