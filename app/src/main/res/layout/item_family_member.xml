<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de la lista de vínculos. Sirve para tres estados: aceptado,
     pendiente de que responda yo (con botones), y pendiente de que
     responda el otro (solo el cartel de "esperando"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/shape_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:elevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar con inicial -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_logo_container"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tv_family_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

        </FrameLayout>

        <!-- Nombre y rol -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_family_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/tv_family_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/ink_4"
                android:layout_marginTop="2dp" />

            <!-- Estado del vínculo. Solo aparece si NO está aceptado: en la
                 lista normal un cartel en cada fila sería ruido. -->
            <TextView
                android:id="@+id/tv_family_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/warn"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_family_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ink_5"
            android:contentDescription="Ver" />

    </LinearLayout>

    <!-- Responder la solicitud. Botones grandes y con la palabra completa:
         quien decide esto puede ser un adulto mayor, y de la respuesta
         depende quién ve su medicación. -->
    <LinearLayout
        android:id="@+id/acciones_solicitud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rechazar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Rechazar"
            android:textSize="15sp"
            android:textColor="@color/ink"
            app:strokeColor="@color/ink_6"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            style="@style/Boton.Principal"
            android:id="@+id/btn_aceptar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Aceptar"
            android:textSize="15sp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
