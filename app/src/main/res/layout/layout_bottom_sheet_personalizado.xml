<?xml version="1.0" encoding="utf-8"?>
<!--
  Hoja inferior del horario personalizado.

  Va dentro de un NestedScrollView a propósito: el teclado numérico del
  campo "cada cuántas horas" se come media pantalla, y sin scroll el botón
  de confirmar quedaba abajo del teclado, fuera de alcance.

  El root es focusableInTouchMode para que el foco inicial se quede acá y
  no lo agarre el campo de texto: si lo agarrara, el teclado se abriría
  solo al abrir la hoja, tapando el reloj antes de que se pueda tocar.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper_2"
    android:focusableInTouchMode="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/personalizado_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/texto_principal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/personalizado_hora_label"
            android:textSize="14sp"
            android:textColor="@color/gris_texto"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="16dp" />

        <!-- Mismo envoltorio que el paso 5a del alta de medicamento: el
             tambor necesita una altura acotada, si no se estira y empuja
             todo lo de abajo fuera de la pantalla. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="20dp">

            <TimePicker
                android:id="@+id/tp_personalizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:timePickerMode="spinner" />
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_intervalo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_intervalo_horas"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_intervalo_horas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:maxLength="2"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_confirmar_personalizado"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_confirmar"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
