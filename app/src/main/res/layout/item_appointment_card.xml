<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/shape_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Badge de fecha: mes + día + hora -->
    <LinearLayout
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/shape_date_badge"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginEnd="14dp">

        <TextView
            android:id="@+id/tv_appt_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/brand_700"
            android:letterSpacing="0.12"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_appt_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/brand_700"
            android:lineSpacingMultiplier="0.9"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_appt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brand_600"
            android:layout_marginTop="2dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Info de la cita -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_appt_doctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tv_appt_especialidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/ink_4"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_map_pin"
                android:tint="@color/ink_4"
                android:contentDescription="Lugar" />

            <TextView
                android:id="@+id/tv_appt_lugar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/ink_4"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/ink_5"
        android:contentDescription="Ver detalle"
        android:layout_marginStart="8dp" />

</LinearLayout>
