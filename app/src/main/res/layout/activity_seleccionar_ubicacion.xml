<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de ubicación: mapa de OpenStreetMap con el pin fijo al
     centro. El buscador y el botón de confirmar son nativos y no HTML,
     para que hereden la tipografía, los colores y el tamaño de toque del
     resto de la app. El WebView solo dibuja el mapa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/shape_neutral_icon_container"
            android:scaleType="center"
            android:tint="@color/ink_2"
            android:contentDescription="Volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Elegir ubicación"
            android:textSize="24sp"
            android:fontFamily="@font/atkinson"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:letterSpacing="-0.02"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Buscador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_buscar"
            style="@style/CampoForm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Buscar hospital, clínica o dirección">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_buscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_buscar"
            style="@style/Boton.Principal"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Buscar"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Mapa + resultados de la búsqueda encima -->
    <!-- minHeight: aunque el teclado no comprima nada, en pantallas
         chicas el mapa no puede quedar reducido a una franja. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="240dp">

        <WebView
            android:id="@+id/mapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/cargando"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- La lista de resultados tapa el mapa mientras está abierta: son
             dos formas de elegir lo mismo y verlas a la vez confunde. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panel_resultados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/resultados_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp" />
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Dirección del punto elegido + confirmar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/paper_2"
        android:elevation="12dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UBICACIÓN ELEGIDA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_4" />

        <TextView
            android:id="@+id/tv_direccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movés el mapa y el pin marca el lugar"
            android:textSize="16sp"
            android:textColor="@color/ink"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Usar esta ubicación"
            android:textSize="17sp"
            app:cornerRadius="18dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>

</LinearLayout>
