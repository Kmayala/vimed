<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta blanca flotante con la hora y el medicamento. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- paper_2, no white: los textos de adentro usan @color/ink, que en
         modo oscuro es casi blanco. Con la tarjeta fija en blanco quedaba
         texto blanco sobre blanco — y es la pantalla de la alarma. -->
    <solid android:color="@color/paper_2" />
    <corners android:radius="24dp" />
</shape>
