<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la barra inferior.

     La barra deja de estar pegada al borde de la pantalla y pasa a ser
     una pieza más, con las mismas esquinas y la misma sombra que las
     tarjetas. Antes era una franja plana a todo lo ancho: se leía como
     parte del sistema operativo y no de la app.

     El borde usa el mismo token que las tarjetas, así que en claro no se
     ve —la separa la sombra— y en oscuro sí, donde la sombra no dibuja. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper_2" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="@color/borde_tarjeta" />
</shape>
