<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta tintada de la familia ambar. El relleno de color es lo que
     saca a la app del blanco sobre blanco: el borde de la misma familia
     la sostiene sin necesidad de sombra. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ambar_50" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/ambar_100" />
</shape>
