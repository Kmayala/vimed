<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight: la paleta ahora existe en los dos tonos (ver
         values-night/colors.xml), así que los diálogos y campos que
         dibuja Material siguen al modo igual que nuestras pantallas.
         Antes esto era Light fijo justamente porque faltaba esa mitad:
         en un celular en oscuro salían campos oscuros sobre nuestros
         fondos claros.

         Qué modo se usa no lo decide el sistema solo: TemaManager
         aplica lo que la persona eligió en Configuración, y "Según el
         sistema" es una de las tres opciones. -->
    <style name="Base.Theme.Vimed" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- ── Tipografía ────────────────────────────────────────
             Atkinson Hyperlegible en toda la app (ver res/font/atkinson.xml
             para por qué esta y no otra).

             Se declara acá y no solo en los layouts porque hay texto que
             la app nunca escribe: los botones de los diálogos, los
             selectores de fecha y hora, los mensajes de error de los
             campos. Sin esto, la mitad de la app quedaba en Atkinson y
             la otra mitad en Roboto sin que se notara de dónde salía. -->
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>

        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/sobre_acento</item>
        <item name="colorPrimaryContainer">@color/brand_100</item>
        <item name="colorOnPrimaryContainer">@color/brand_800</item>
        <item name="colorSecondary">@color/brand_400</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/paper_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/ink_8</item>
        <item name="colorOnSurfaceVariant">@color/ink_3</item>
        <item name="colorOutline">@color/ink_6</item>
        <item name="colorError">@color/danger</item>

        <!-- ── Diálogos y selectores del sistema ─────────────────
             Sin esto, los ~58 AlertDialog de la app y los pickers de
             fecha y hora se dibujan con el estilo de Android: otro
             fondo, otras esquinas, otro violeta. Se atan acá y no en
             cada llamada, así ninguna pantalla puede olvidarse. -->
        <item name="alertDialogTheme">@style/Theme.Vimed.Dialogo</item>
        <item name="materialAlertDialogTheme">@style/Theme.Vimed.Dialogo</item>

        <!-- ── Barras del sistema ──────────────────────────────
             Desde Android 15 (targetSdk 35+) el sistema fuerza
             edge-to-edge: la app dibuja debajo de la barra de
             estado. fitsSystemWindows agrega el padding necesario
             para que el contenido no quede tapado.              -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Fondos claros → íconos de la barra en oscuro -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Vimed" parent="Base.Theme.Vimed" />

    <!-- Diálogos: fondo y esquinas de la app, botones en el violeta
         de la marca. Hereda de Material3 para que el modo oscuro lo
         resuelva la misma paleta. -->
    <style name="Theme.Vimed.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorSurface">@color/paper_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_3</item>
        <item name="android:windowBackground">@drawable/shape_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Boton.Dialogo</item>
        <item name="buttonBarNegativeButtonStyle">@style/Boton.Dialogo</item>
        <item name="buttonBarNeutralButtonStyle">@style/Boton.Dialogo</item>
    </style>

    <!-- ── Botón principal ───────────────────────────────────────
         El botón lleno de la app: relleno violeta profundo y texto
         blanco, IGUAL en los dos modos.

         Existe porque ese par no puede salir de colorPrimary /
         colorOnPrimary. Esos dos atributos también gobiernan el TEXTO de
         los botones de contorno y de los diálogos, que de noche tiene
         que ser claro para verse sobre la tarjeta; el relleno, en
         cambio, tiene que seguir siendo oscuro para que el blanco de
         encima se lea. Un solo par de tokens no puede cumplir las dos
         cosas, y cuando se lo forzaba, la mitad de los botones quedaba
         invisible en oscuro.

         Cualquier botón lleno nuevo debería usar este estilo en vez de
         repetir backgroundTint y textColor a mano. -->
    <style name="Boton.Principal" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Boton.Dialogo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_600</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- Alarma a pantalla completa: el header violeta tiene que llegar hasta
         el borde superior, por detrás de la barra de estado. Por eso acá
         apagamos fitsSystemWindows (el layout pone su propio paddingTop) y
         los íconos de la barra pasan a blancos, que es lo legible sobre
         violeta. La barra de abajo queda clara, como el fondo de la pantalla. -->
    <!-- Fila de opción de la pantalla de Configuración. Alta (72dp) y de
         ancho completo: el objetivo de toque es toda la fila, no un
         radio button de 20dp. -->
    <style name="OpcionTema">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/shape_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:elevation">3dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Chip del selector de período en Progreso. -->
    <style name="ChipPeriodo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/shape_chip_periodo</item>
        <item name="android:textColor">@color/texto_chip_periodo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Píldora de la barra inferior. Lavanda y no cian: el cian a
         pleno resulta demasiado estridente para una app que usa un
         adulto mayor todos los días. -->
    <style name="IndicadorNav" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_100</item>
    </style>

    <!-- ── Formularios ──────────────────────────────────────
         Los campos sueltos uno debajo del otro se leen como planilla.
         Agrupados en tarjetas con un título que hace una pregunta, el
         formulario se recorre por partes y se ve cuánto falta. -->
    <style name="TituloSeccionForm">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="TarjetaForm">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/shape_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:elevation">3dp</item>
    </style>

    <style name="CampoForm" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/brand_500</item>
        <item name="hintTextColor">@color/ink_3</item>
        <item name="android:textColorHint">@color/ink_4</item>
    </style>

    <!-- Campo con lista desplegable.
         Hereda de ExposedDropdownMenu y no del OutlinedBox común: es el
         padre que Material espera cuando el campo tiene un
         MaterialAutoCompleteTextView adentro. Con el otro, la flecha del
         final queda como un icono suelto y el toque para abrir la lista lo
         tiene que resolver la Activity a mano — que era justamente lo que
         rompía el abrir y cerrar. -->
    <style name="CampoForm.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/brand_500</item>
        <item name="hintTextColor">@color/ink_3</item>
        <item name="android:textColorHint">@color/ink_4</item>
        <item name="endIconTint">@color/ink_3</item>
    </style>

    <style name="CheckTema">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:src">@drawable/ic_check</item>
        <item name="android:contentDescription">Elegido</item>
    </style>

    <style name="Theme.Vimed.Alarma" parent="Base.Theme.Vimed">
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

</resources>
