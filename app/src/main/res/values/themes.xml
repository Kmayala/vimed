<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight: la paleta ahora existe en los dos tonos (ver
         values-night/colors.xml), así que los diálogos y campos que
         dibuja Material siguen al modo igual que nuestras pantallas.
         Antes esto era Light fijo justamente porque faltaba esa mitad:
         en un celular en oscuro salían campos oscuros sobre nuestros
         fondos claros.

         Qué modo se usa no lo decide el sistema solo: TemaManager
         aplica lo que la persona eligió en Configuración, y "Según el
         sistema" es una de las tres opciones. -->
    <style name="Base.Theme.Vimed" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_100</item>
        <item name="colorOnPrimaryContainer">@color/brand_800</item>
        <item name="colorSecondary">@color/brand_400</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/paper_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/ink_8</item>
        <item name="colorOnSurfaceVariant">@color/ink_3</item>
        <item name="colorOutline">@color/ink_6</item>
        <item name="colorError">@color/danger</item>

        <!-- ── Diálogos y selectores del sistema ─────────────────
             Sin esto, los ~58 AlertDialog de la app y los pickers de
             fecha y hora se dibujan con el estilo de Android: otro
             fondo, otras esquinas, otro violeta. Se atan acá y no en
             cada llamada, así ninguna pantalla puede olvidarse. -->
        <item name="alertDialogTheme">@style/Theme.Vimed.Dialogo</item>
        <item name="materialAlertDialogTheme">@style/Theme.Vimed.Dialogo</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Vimed.Picker</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Vimed.Picker</item>

        <!-- ── Barras del sistema ──────────────────────────────
             Desde Android 15 (targetSdk 35+) el sistema fuerza
             edge-to-edge: la app dibuja debajo de la barra de
             estado. fitsSystemWindows agrega el padding necesario
             para que el contenido no quede tapado.              -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Fondos claros → íconos de la barra en oscuro -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Vimed" parent="Base.Theme.Vimed" />

    <!-- Diálogos: fondo y esquinas de la app, botones en el violeta
         de la marca. Hereda de Material3 para que el modo oscuro lo
         resuelva la misma paleta. -->
    <style name="Theme.Vimed.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorSurface">@color/paper_2</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_3</item>
        <item name="android:windowBackground">@drawable/shape_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Boton.Dialogo</item>
        <item name="buttonBarNegativeButtonStyle">@style/Boton.Dialogo</item>
        <item name="buttonBarNeutralButtonStyle">@style/Boton.Dialogo</item>
    </style>

    <style name="Boton.Dialogo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/brand_600</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Los pickers de fecha y hora son del framework, no de Material:
         necesitan un tema propio con el acento de la app. -->
    <style name="Theme.Vimed.Picker" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/brand_500</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowBackground">@drawable/shape_dialog</item>
    </style>

    <!-- Alarma a pantalla completa: el header violeta tiene que llegar hasta
         el borde superior, por detrás de la barra de estado. Por eso acá
         apagamos fitsSystemWindows (el layout pone su propio paddingTop) y
         los íconos de la barra pasan a blancos, que es lo legible sobre
         violeta. La barra de abajo queda clara, como el fondo de la pantalla. -->
    <!-- Fila de opción de la pantalla de Configuración. Alta (72dp) y de
         ancho completo: el objetivo de toque es toda la fila, no un
         radio button de 20dp. -->
    <style name="OpcionTema">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/shape_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Chip del selector de período en Progreso. -->
    <style name="ChipPeriodo">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/shape_chip_periodo</item>
        <item name="android:textColor">@color/texto_chip_periodo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CheckTema">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:src">@drawable/ic_check</item>
        <item name="android:contentDescription">Elegido</item>
    </style>

    <style name="Theme.Vimed.Alarma" parent="Base.Theme.Vimed">
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

</resources>
