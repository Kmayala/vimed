    <color name="gris_texto">#4f4b72</color>

    <!-- ── Semánticos (estados) ───────────────────────────── -->
    <color name="success">#04553e</color>
    <color name="success_bg">#e6f7f1</color>
    <!-- Las alertas (stock bajo, permisos de la alarma) vuelven al
         ámbar. Es el color con el que la gente ya lee "atención" y
         meterlo en la escala violeta les sacaba justamente eso. -->
    <color name="warn">#6f4400</color>
    <color name="warn_bg">#fef3c7</color>
    <color name="warn_border">#f4cf7d</color>
    <!-- El único color fuera de la paleta, y a propósito: una toma que
         no se tomó tiene que saltar a la vista. En la escala violeta se
         confundía con "pospuesta" y en una app de medicación eso importa. -->
    <color name="danger">#a3123a</color>
    <color name="danger_bg">#fdecf3</color>
    <color name="info">#1e40af</color>
    <color name="info_bg">#e8f1fe</color>

    <!-- ── Colores de pastillas (fondo de círculo, texto blanco) -->
