    <color name="rojo_error">#a3123a</color>

    <!-- ── Pantalla de alarma ─────────────────────────────────
         Verde del botón "Ya tomé": más oscuro que el verde puro para que
         el texto blanco en negrita quede sobre 3:1 (mínimo AA en texto
         grande). Un verde más brillante se vería lindo pero ilegible. -->
    <!-- Texto secundario del header violeta de la alarma.
         NO tiene versión oscura a propósito: ese header es el mismo
         violeta en los dos modos, así que su texto tampoco cambia. Si
         usara brand_100 —como antes— en modo oscuro se volvería violeta
         oscuro sobre violeta y se perdería (2.9 contra 3.93). -->
    <color name="alarma_header_sub">#e4dcfd</color>

    <!-- Texto secundario sobre la tarjeta destacada (paciente, próxima
         cita). Fijo en los dos modos, por el mismo motivo que
         alarma_header_sub: esa tarjeta es oscura siempre, así que su
         texto tiene que ser claro siempre. -->
    <color name="sobre_superficie_oscura">#c9bcfb</color>

    <color name="alarma_verde">#0a7d55</color>
    <color name="alarma_verde_ripple">#3315803d</color>

    <!-- ── Superficie oscura (tarjeta destacada de próxima cita y
         del paciente en la vista del cuidador).
         Pasa a ser el violeta profundo de la paleta en vez de un gris
         azulado: es el mismo extremo oscuro de la escala, así que la
         tarjeta se lee como parte de la familia y no como un bloque
         negro prestado de otro diseño. Texto blanco encima: 17.7.  -->
    <color name="surface_dark">#2e1780</color>
    <color name="surface_dark_2">#5b34e8</color>

    <!-- Fondo del ícono adaptativo. No tiene versión oscura: el ícono
