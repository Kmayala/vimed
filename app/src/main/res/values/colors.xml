    <color name="pill_verde">#0a7d55</color>
    <color name="pill_morado">#5b34e8</color>
    <color name="pill_gris">#6b6790</color>

    <!-- Texto e íconos que van ENCIMA del color de acento (colorPrimary).
         En claro el acento es el violeta oscuro, así que encima va blanco.
         En oscuro el acento se aclara y encima tiene que ir oscuro: es el
         par que hay que mover junto, o los botones se vuelven invisibles. -->
    <color name="sobre_acento">#ffffff</color>

